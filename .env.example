# .env.example (backer-frontend)
# Copy this file to .env and fill in the values for your environment.

# Base URL of this frontend app, used by @sidebase/nuxt-auth for auth origin/CORS.
AUTH_ORIGIN=http://localhost:3000

# Base URL of the backer-backend API (including the /api/v1 prefix).
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

# Base URL used to load uploaded images/assets served by the backend (no path prefix).
NUXT_PUBLIC_IMAGE_BASE=http://localhost:8080
